# Copia este archivo como ".env" (local) o cárgalo como variables de entorno en tu hosting.
# NUNCA subas el archivo .env a GitHub.

NODE_ENV=production
PORT=3000
# URL pública de tu tienda, sin barra final. Wompi regresa a las clientas a esta dirección.
BASE_URL=https://tu-dominio.com
# Pon 1 si tu hosting está detrás de un proxy (Render, Railway, Fly, Hostinger...).
TRUST_PROXY=1
# Carpeta donde se guardan la base de datos y las imágenes subidas (debe ser almacenamiento PERSISTENTE).
DATA_DIR=./data
# true = si la base está vacía, carga 8 productos de ejemplo. Pon false para empezar sin productos.
SEED_DEMO=true
# Horas que se reserva el inventario de un pedido con pago en línea sin pagar.
RESERVA_HORAS=24

# Cuenta administradora inicial (solo si no tienes terminal). Se usa una vez y luego BORRA ADMIN_PASSWORD.
# Alternativa recomendada: ejecutar `npm run crear-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Wompi — dejar vacío = solo pago por transferencia/acuerdo. Claves de PRUEBA empiezan por pub_test_
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
